{
  "name": "bb-plugin-terminal-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Terminal Hub for BB: see and control every terminal running in a checkout or worktree.",
  "license": "MIT",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.37"
  },
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:specs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:specs": "node scripts/check-specs.mjs",
    "build": "bb plugin build",
    "test:live": "node scripts/smoke-live.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@get-bb/plugin-sdk": "0.6.37",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.2",
    "hono": "^4.13.13",
    "jsdom": "^26.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "7.0.2",
    "vaul": "^1.1.2",
    "vitest": "5.0.3"
  },
  "bb": {
    "name": "Terminal Hub",
    "description": "See and control every terminal running in a checkout or worktree, whichever thread or agent started it.",
    "branding": {
      "icon": "Terminal"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "@wterm/dom": "0.5.0",
    "@wterm/ghostty": "0.5.0",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
